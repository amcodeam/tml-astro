---
import BaseLayout from "../components/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import SiteHeader from "../components/SiteHeader.astro";

const sections = [
  {
    id: "overall",
    title: "Top 10 Overall",
    description: "Live favorites across both weekends.",
  },
  {
    id: "week1",
    title: "Top 10 Week 1",
    description: "Most selected artists from weekend one.",
  },
  {
    id: "week2",
    title: "Top 10 Week 2",
    description: "Most selected artists from weekend two.",
  },
];
const bodyAttrs = {
  "data-convex-url": import.meta.env.PUBLIC_CONVEX_URL,
};
---

<BaseLayout title="Cool Stats - Tomorrowland Line-Up Selector" bodyAttrs={bodyAttrs}>
  <Fragment slot="head">
    <style is:global>
      main {
        display: grid;
        gap: 32px;
        padding: 20px 32px 60px;
      }

      .status {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .stats-state {
        display: grid;
        gap: 20px;
        justify-items: center;
      }

      .stats-loading,
      .stats-down {
        background: rgba(18, 6, 11, 0.9);
        border-radius: 24px;
        padding: 24px 28px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        text-align: center;
        width: min(520px, 100%);
      }

      .stats-down h2 {
        margin: 0 0 8px;
        font-size: 20px;
      }

      .stats-down p {
        margin: 0 0 16px;
        color: var(--text-muted);
      }

      .stats-loading p {
        margin: 12px 0 0;
        color: var(--text-muted);
      }

      .loading-dots {
        display: inline-flex;
        gap: 8px;
      }

      .loading-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-bright);
        box-shadow: 0 0 12px rgba(208, 65, 119, 0.4);
        animation: pulse-dot 1.2s ease-in-out infinite;
      }

      .loading-dots span:nth-child(2) {
        animation-delay: 0.2s;
      }

      .loading-dots span:nth-child(3) {
        animation-delay: 0.4s;
      }

      @keyframes pulse-dot {
        0%,
        100% {
          transform: scale(0.7);
          opacity: 0.45;
        }
        50% {
          transform: scale(1);
          opacity: 1;
        }
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
      }

      .stats-card {
        background: rgba(18, 6, 11, 0.9);
        border-radius: 24px;
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 320px;
      }

      .stats-card header h2 {
        margin: 0 0 6px;
        font-size: 20px;
      }

      .stats-card header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
      }

      .stats-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .stats-row {
        display: grid;
        grid-template-columns: 32px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .rank {
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .name {
        font-size: 14px;
        font-weight: 600;
      }

      .count {
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .empty {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
      }
    </style>
  </Fragment>

  <SiteHeader current="stats" />

  <main>
    <HeroSection>
      <Fragment slot="top">
        <span class="hero-tag">Cool Stats</span>
      </Fragment>
      <h1>Real-time DJ favorites.</h1>
      <p>
        These rankings update live based on every pick made on the line-up page.
        Add or remove artists and watch the lists shift.
      </p>
      <p class="status" data-status>
        Live feed ready. Your picks update these lists instantly.
      </p>
    </HeroSection>

    <section class="stats-state">
      <div class="stats-loading" data-stats-loading>
        <div class="loading-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <p>Loading live stats...</p>
      </div>
      <div class="stats-down hidden" data-stats-down>
        <h2>Stats are down right now.</h2>
        <p>Hang tight or head back to the line-up while we reconnect.</p>
        <a class="pill primary" href="/">Back to Line-Up</a>
      </div>
    </section>

    <section class="stats-grid hidden" data-stats-grid>
      {sections.map((section) => (
        <article class="stats-card" data-panel={section.id}>
          <header>
            <h2>{section.title}</h2>
            <p>{section.description}</p>
          </header>
          <ol class="stats-list" data-list={section.id}></ol>
          <p class="empty" data-empty={section.id}>
            No picks yet. Make a selection to start the leaderboard.
          </p>
        </article>
      ))}
    </section>
  </main>

</BaseLayout>
