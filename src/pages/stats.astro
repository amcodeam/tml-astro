---
import BaseLayout from "../components/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import SiteHeader from "../components/SiteHeader.astro";
import statsScript from "../scripts/stats.js?url";

const sections = [
  {
    id: "overall",
    title: "Top 10 Overall",
    description: "Live favorites across both weekends.",
  },
  {
    id: "week1",
    title: "Top 10 Week 1",
    description: "Most selected artists from weekend one.",
  },
  {
    id: "week2",
    title: "Top 10 Week 2",
    description: "Most selected artists from weekend two.",
  },
];
const bodyAttrs = {
  "data-convex-url": import.meta.env.PUBLIC_CONVEX_URL,
};
---

<BaseLayout title="Cool Stats - Tomorrowland Line-Up Selector" bodyAttrs={bodyAttrs}>
  <Fragment slot="head">
    <style is:global>
      main {
        display: grid;
        gap: 32px;
        padding: 20px 32px 60px;
      }

      .status {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
      }

      .stats-card {
        background: rgba(18, 6, 11, 0.9);
        border-radius: 24px;
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 320px;
      }

      .stats-card header h2 {
        margin: 0 0 6px;
        font-size: 20px;
      }

      .stats-card header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
      }

      .stats-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .stats-row {
        display: grid;
        grid-template-columns: 32px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .rank {
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .name {
        font-size: 14px;
        font-weight: 600;
      }

      .count {
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .empty {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
      }
    </style>
  </Fragment>

  <SiteHeader>
    <Fragment slot="actions">
      <a class="pill ghost" href="/">Line-Up</a>
    </Fragment>
  </SiteHeader>

  <main>
    <HeroSection>
      <Fragment slot="top">
        <span class="hero-tag">Cool Stats</span>
      </Fragment>
      <h1>Real-time DJ favorites.</h1>
      <p>
        These rankings update live based on every pick made on the line-up page.
        Add or remove artists and watch the lists shift.
      </p>
      <p class="status" data-status>
        Live feed ready. Your picks update these lists instantly.
      </p>
    </HeroSection>

    <section class="stats-grid hidden" data-stats-grid>
      {sections.map((section) => (
        <article class="stats-card" data-panel={section.id}>
          <header>
            <h2>{section.title}</h2>
            <p>{section.description}</p>
          </header>
          <ol class="stats-list" data-list={section.id}></ol>
          <p class="empty" data-empty={section.id}>
            No picks yet. Make a selection to start the leaderboard.
          </p>
        </article>
      ))}
    </section>
  </main>

  <script type="module" src={statsScript}></script>
</BaseLayout>
